# Spotify Web API (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Optional: Apple Music / MusicKit (official path for catalog + playlists)
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=

# iCloud.com scraping is not supported — use MusicKit / user export instead
VIBESHIFT_LOG_LEVEL=INFO
