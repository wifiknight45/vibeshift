# Spotify Web API — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Apple MusicKit — https://developer.apple.com (see docs/APPLE_MUSIC.md)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_MUSIC_USER_TOKEN=
APPLE_STOREFRONT=us

# Perplexity Sonar API (official — do not scrape the website)
# https://docs.perplexity.ai/
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

VIBESHIFT_LOG_LEVEL=INFO
VIBESHIFT_TOKEN_DIR=.vibeshift
